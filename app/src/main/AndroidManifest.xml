<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Filled by the selected store flavor at build time. -->
    <uses-permission android:name="${marketPermission}" />

    <!-- Required by Myket's billing client (only used when the app was installed from
         Myket) - straight from Myket's own "جاوا (Java)" integration docs. -->

    <!-- Android 11+ package visibility: lets the billing SDKs
         actually see/bind to the Bazaar and Myket apps if installed. -->
    <queries>
        <package android:name="com.farsitel.bazaar" />
        <package android:name="ir.mservices.market" />
        <intent>
            <action android:name="ir.mservices.market.InAppBillingService.BIND" />
        </intent>
        <intent>
            <action android:name="ir.cafebazaar.pardakht.InAppBillingService.BIND" />
        </intent>
    </queries>

    <!-- Opt-in only (see PreferencesManager.isSmsReadingEnabled, off by default) - lets the
         app recognize bank transaction SMS and auto-record them as accounting entries. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- Needed so the app can keep a foreground service (persistent notification)
         alive to keep smart reminders / assistant features responsive in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Lets a smart-reminder alarm launch its full-screen activity immediately when it
         fires, even if the app is in the background - the same mechanism real alarm-clock
         and incoming-call apps use to bypass the background-activity-start restriction. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:name=".MaliarProApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaliarPro"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MaliarPro">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Records a short voice command (e.g. "به علی زنگ بزن"), transcribes it, and
             after a plain confirmation dialog places a real call to the matched contact.
             Launched from the persistent background notification's action button. -->
        <activity
            android:name=".ui.assistant.VoiceCommandActivity"
            android:exported="false"
            android:theme="@style/Theme.MaliarPro" />

        <!-- Subscription / premium upgrade screen -->
        <activity
            android:name=".ui.profile.SubscriptionActivity"
            android:exported="false"
            android:label="اشتراک پریمیوم"
            android:theme="@style/Theme.MaliarPro" />

        <!-- Full Screen Alarm Activity -->
        <activity
            android:name=".ui.reminders.FullScreenAlarmActivity"
            android:exported="true"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.MaliarPro.Alarm" />

        <!-- Reminder Receivers -->
        <receiver
            android:name=".receivers.ReminderReceiver"
            android:exported="true" />

        <receiver
            android:name=".receivers.ReminderActionReceiver"
            android:exported="true" />

        <!-- Reschedules all active reminder alarms after a device reboot -->
        <receiver
            android:name=".receivers.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Opt-in (Settings toggle) bank-transaction SMS reader - see SmsReceiver.kt.
             android:permission restricts who can even trigger this broadcast to the
             platform itself, on top of the runtime-permission and Settings-toggle checks
             already inside the receiver. -->
        <receiver
            android:name=".receivers.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="500">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Keeps the process alive in the background with a persistent, low-priority
             notification so smart reminders / assistant features keep working reliably
             even when the app UI isn't open. -->
        <service
            android:name=".services.MaliarBackgroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps smart reminders and the assistant responsive in the background" />
        </service>

        <!-- Speaks a smart reminder aloud (TTS) the instant its alarm fires, and repeats
             it until the person marks it done - see SmartReminderTtsService for details.
             Uses "specialUse" (the same type MaliarBackgroundService above already uses
             successfully) rather than "mediaPlayback", which has stricter and less
             predictable enforcement across Android versions/OEMs. -->
        <service
            android:name=".receivers.SmartReminderTtsService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Speaks a smart reminder aloud and repeats it until dismissed" />
        </service>

    </application>

</manifest>
