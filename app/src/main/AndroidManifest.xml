<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Voice command recording; requested only when user taps the mic button -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Full-screen intent for alarm reminders. Android 14+ requires this explicit
         declaration for USE_FULL_SCREEN_INTENT; the permission is only requested when
         the user first creates a FULL_SCREEN or SMART reminder. Play Store policy
         allows this for alarm/reminder apps. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Used only after an explicit opt-in in Settings; never started automatically. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Lets us show the system "ignore battery optimization" dialog so reminders and the
         home-screen widget keep refreshing on phones (Xiaomi/Samsung/Huawei, etc.) that
         otherwise freeze background apps and show a stale/blank widget. Only ever opens a
         system dialog the person can accept or dismiss; nothing is granted automatically. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Filled by the selected store flavor at build time. -->
    <uses-permission android:name="${marketPermission}" />

    <!-- Required by Myket's billing client (only used when the app was installed from
         Myket) - straight from Myket's own "جاوا (Java)" integration docs. -->

    <!-- Android 11+ package visibility: lets the billing SDKs
         actually see/bind to the Bazaar and Myket apps if installed. -->
    <queries>
        <package android:name="com.farsitel.bazaar" />
        <package android:name="ir.mservices.market" />
        <intent>
            <action android:name="ir.mservices.market.InAppBillingService.BIND" />
        </intent>
        <intent>
            <action android:name="ir.cafebazaar.pardakht.InAppBillingService.BIND" />
        </intent>
    </queries>


    <application
        android:name=".MaliarProApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaliarPro"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MaliarPro">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- First-launch intro shown once (MainActivity redirects here until
             PreferencesManager.isOnboardingCompleted() is true) -->
        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.MaliarPro" />

        <!-- Subscription / premium upgrade screen -->
        <activity
            android:name=".ui.profile.SubscriptionActivity"
            android:exported="false"
            android:label="اشتراک پریمیوم"
            android:theme="@style/Theme.MaliarPro" />

        <!-- Full Screen Alarm Activity -->
        <activity
            android:name=".ui.reminders.FullScreenAlarmActivity"
            android:exported="true"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.MaliarPro.Alarm" />

        <!-- Voice command: record and transcribe a short command to create an expense,
             a reminder, or make a call. Launched from the notification action or the
             voice FAB in the assistant tab. -->
        <activity
            android:name=".ui.assistant.VoiceCommandActivity"
            android:exported="false"
            android:theme="@style/Theme.MaliarPro"
            android:label="دستور صوتی" />

        <!-- Exposes cache-dir files (currently: generated smart-reminder TTS audio) to the
             system as content:// URIs, e.g. so a heads-up notification (posted while the
             device is unlocked and the app is backgrounded, where Android intentionally
             won't auto-launch FullScreenAlarmActivity - see ReminderReceiver) can still
             play the spoken reminder as its notification sound instead of the plain alarm
             tone. Nothing here is exported/world-readable; access is only ever granted
             per-URI via FLAG_GRANT_READ_URI_PERMISSION. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.maliar.pro.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Reminder Receivers -->
        <receiver
            android:name=".receivers.ReminderReceiver"
            android:exported="true" />

        <receiver
            android:name=".receivers.ReminderActionReceiver"
            android:exported="true" />

        <!-- Reschedules all active reminder alarms after a device reboot -->
        <receiver
            android:name=".receivers.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Optional reliability mode. The user turns this on in Settings; it is not
             started at install, launch, or device boot. -->
        <service
            android:name=".services.MaliarBackgroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Optional user-enabled reminder reliability mode" />
        </service>

        <!-- Home-screen widget: read-only balance + next reminder summary. Standard
             AppWidgetProvider pattern, no new permissions, no background service. -->
        <receiver
            android:name=".widget.MaliarSummaryWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_maliar_summary_info" />
        </receiver>

    </application>

</manifest>

