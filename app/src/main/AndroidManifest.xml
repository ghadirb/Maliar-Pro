<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Used only after an explicit opt-in in Settings; never started automatically. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Filled by the selected store flavor at build time. -->
    <uses-permission android:name="${marketPermission}" />

    <!-- Required by Myket's billing client (only used when the app was installed from
         Myket) - straight from Myket's own "جاوا (Java)" integration docs. -->

    <!-- Android 11+ package visibility: lets the billing SDKs
         actually see/bind to the Bazaar and Myket apps if installed. -->
    <queries>
        <package android:name="com.farsitel.bazaar" />
        <package android:name="ir.mservices.market" />
        <intent>
            <action android:name="ir.mservices.market.InAppBillingService.BIND" />
        </intent>
        <intent>
            <action android:name="ir.cafebazaar.pardakht.InAppBillingService.BIND" />
        </intent>
    </queries>


    <application
        android:name=".MaliarProApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaliarPro"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MaliarPro">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- First-launch intro shown once (MainActivity redirects here until
             PreferencesManager.isOnboardingCompleted() is true) -->
        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.MaliarPro" />

        <!-- Subscription / premium upgrade screen -->
        <activity
            android:name=".ui.profile.SubscriptionActivity"
            android:exported="false"
            android:label="اشتراک پریمیوم"
            android:theme="@style/Theme.MaliarPro" />

        <!-- Full Screen Alarm Activity -->
        <activity
            android:name=".ui.reminders.FullScreenAlarmActivity"
            android:exported="true"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.MaliarPro.Alarm" />

        <!-- Reminder Receivers -->
        <receiver
            android:name=".receivers.ReminderReceiver"
            android:exported="true" />

        <receiver
            android:name=".receivers.ReminderActionReceiver"
            android:exported="true" />

        <!-- Reschedules all active reminder alarms after a device reboot -->
        <receiver
            android:name=".receivers.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Optional reliability mode. The user turns this on in Settings; it is not
             started at install, launch, or device boot. -->
        <service
            android:name=".services.MaliarBackgroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Optional user-enabled reminder reliability mode" />
        </service>

        <!-- Home-screen widget: read-only balance + next reminder summary. Standard
             AppWidgetProvider pattern, no new permissions, no background service. -->
        <receiver
            android:name=".widget.MaliarSummaryWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_maliar_summary_info" />
        </receiver>

    </application>

</manifest>
