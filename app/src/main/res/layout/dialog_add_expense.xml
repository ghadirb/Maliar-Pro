<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!--
        Category field: previously a plain AutoCompleteTextView with no visual cue that
        it opens a picker, and its dropdown reused a tiny system row layout that was
        hard to tap and read (see item_category_dropdown.xml / AddExpenseDialog.kt /
        EditExpenseDialog.kt for the matching adapter + popup setup). The end icon below
        gives it an obvious "tap to choose" affordance, and minHeight keeps the field
        itself comfortably tall instead of shrinking to the text's natural size.
    -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/categoryInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="دسته‌بندی"
        app:endIconMode="custom"
        app:endIconDrawable="@drawable/ic_dropdown_arrow"
        app:endIconContentDescription="نمایش دسته‌بندی‌ها">

        <AutoCompleteTextView
            android:id="@+id/categoryInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:textSize="16sp"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="مبلغ"
        android:layout_marginTop="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/amountInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="توضیحات"
        android:layout_marginTop="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/descriptionInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine" />
    </com.google.android.material.textfield.TextInputLayout>

    <!--
        Account picker: lets this expense be linked to one of "حساب‌های من" so its
        balance is deducted automatically (see FinancialStatusManager.adjustAssetBalance
        via AccountingManager.addExpense/updateExpense). First entry is always "بدون
        حساب مشخص" (unlinked, falls back to the daily-spending account exactly like
        before this picker existed) - see AddExpenseDialog.kt / EditExpenseDialog.kt for
        how the list is populated.
    -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="حساب"
        android:layout_marginTop="16dp"
        android:textSize="14sp" />

    <Spinner
        android:id="@+id/accountSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

</LinearLayout>
