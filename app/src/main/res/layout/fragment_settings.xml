<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تنظیمات"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFF8E1"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ اشتراک پریمیوم"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/subscriptionStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="#757575" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/manageSubscriptionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="مدیریت اشتراک" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="نوع نوتیفیکیشن"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/notificationModeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/noneNotification"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="بدون نوتیفیکیشن" />

                    <RadioButton
                        android:id="@+id/actionNotification"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="با نوتیفیکیشن (دکمه‌های انجام شد / تعویق / تماس)" />

                </RadioGroup>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/backgroundServiceSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="نگه‌داشتن برنامه در پس‌زمینه" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="یک نوتیفیکیشن بی‌صدا و ثابت نشان می‌دهد، اما یادآوری‌های هوشمند و دستیار را قابل‌اعتمادتر می‌کند. خاموش کردن این گزینه، آن نوتیفیکیشن را کاملاً حذف می‌کند ولی ممکن است در بعضی گوشی‌ها یادآوری‌ها با کمی تأخیر برسند."
                    android:textSize="12sp"
                    android:textColor="#757575" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="پشتیبان‌گیری و بازیابی"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="تمام اطلاعات برنامه (حسابداری، یادآوری‌ها، مخاطبین، وضعیت مالی) در یک فایل zip ذخیره می‌شود. مقصد را خودتان از صفحه‌ی بعد انتخاب می‌کنید - می‌تواند حافظه‌ی گوشی یا هر سرویسی مثل گوگل‌درایو باشد که روی گوشی نصب دارید."
                    android:textSize="12sp"
                    android:textColor="#757575" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/backupNowButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="تهیه پشتیبان" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/restoreButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="بازیابی" />

                </LinearLayout>

                <TextView
                    android:id="@+id/backupStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="12sp"
                    android:textColor="#757575"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#E0E0E0" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/autoBackupSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="همگام‌سازی خودکار روزانه" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="هر روز یک نسخه‌ی جدید در همان مقصدی که بار اول انتخاب کردید ذخیره می‌شود و نسخه‌ی قبلی را جایگزین می‌کند. ابتدا یک بار «تهیه پشتیبان» را بزنید تا مقصد ثبت شود."
                    android:textSize="12sp"
                    android:textColor="#757575" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>



    </LinearLayout>

</ScrollView>
