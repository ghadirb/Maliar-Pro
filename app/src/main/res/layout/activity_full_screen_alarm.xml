<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_full_screen_alarm"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="28dp"
    android:paddingTop="48dp"
    android:paddingBottom="36dp">

    <TextView
        android:id="@+id/alarmTypeHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_slide_track"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text=""
        android:textColor="#8FD8FF"
        android:textSize="13sp"
        android:visibility="gone" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/alarmIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔔"
        android:textSize="72sp"
        android:layout_marginBottom="28dp" />

    <TextView
        android:id="@+id/alarmTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="یادآوری"
        android:textColor="@android:color/white"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/alarmDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text=""
        android:textColor="#CCFFFFFF"
        android:textSize="18sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="2" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="برای توقف به راست، برای تعویق به چپ بکشید"
        android:textColor="#99FFFFFF"
        android:textSize="13sp"
        android:layout_marginBottom="14dp" />

    <FrameLayout
        android:id="@+id/slideTrack"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/bg_slide_track">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left|center_vertical"
            android:paddingStart="24dp"
            android:text="⏰ تعویق"
            android:textColor="#FFD54F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right|center_vertical"
            android:paddingEnd="24dp"
            android:text="متوقف ✋"
            android:textColor="#4CAF50"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/slideHandle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#4FC3F7">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="↔"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/completeButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="✅ علامت‌گذاری به‌عنوان انجام‌شده"
        android:textColor="#B3FFFFFF" />

</LinearLayout>
