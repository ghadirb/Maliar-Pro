<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MaliarPro" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="materialCardViewStyle">@style/Widget.MaliarPro.Card</item>
        <item name="materialButtonStyle">@style/Widget.MaliarPro.Button.Primary</item>
        <item name="floatingActionButtonStyle">@style/Widget.MaliarPro.FloatingActionButton</item>
    </style>

    <!-- Alarm Theme for FullScreenAlarmActivity -->
    <style name="Theme.MaliarPro.Alarm" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/alarm_background</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:textColorSecondary">#B3FFFFFF</item>
        <item name="android:statusBarColor">#FF1A1A2E</item>
        <item name="android:navigationBarColor">#FF1A1A2E</item>
    </style>

    <!--
        The default android.app.TimePickerDialog uses colorAccent (teal #03DAC5) as its
        header background with light/white numerals, which made the hour/minute numbers
        hard to read. This theme forces a solid, high-contrast header (dark purple
        background with white numerals) so the time is always clearly legible.

        Deliberately does NOT override android:windowBackground here (a previous version
        did) - that override was clipping the dialog's own bounds on some devices/screen
        sizes, which pushed the OK/Cancel button row below the visible dialog area
        entirely, making the picker impossible to confirm without a hardware back button.
    -->
    <style name="Theme.MaliarPro.TimePickerDialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="colorAccent">@color/primary</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorControlActivated">@color/primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="buttonBarPositiveButtonStyle">@style/MaliarPro.TimePickerDialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/MaliarPro.TimePickerDialog.Button</item>
    </style>

    <!-- Explicit, unmistakably visible OK/Cancel buttons - bold primary-colored text on
         a plain background, so they can't blend into anything else regardless of theme. -->
    <style name="MaliarPro.TimePickerDialog.Button" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!--
        Assist-chip's default checked/unchecked contrast was too subtle for people to
        tell what's selected at a glance (both priority and alert-type chips looked
        almost identical either way). This forces an unmistakable solid purple fill +
        white bold text when selected vs. a light tint + dark text when not.
    -->
    <style name="MaliarPro.Chip.Selectable" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background_selector</item>
        <item name="android:textColor">@color/chip_text_selector</item>
        <item name="chipStrokeColor">@color/chip_stroke_selector</item>
        <item name="chipStrokeWidth">1.5dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Shared UI components. Keep semantic names so XML screens can adopt a common
         visual language without coupling any financial/domain logic to the UI. -->
    <style name="Widget.MaliarPro.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">@color/ds_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.MaliarPro.Card.Hero" parent="Widget.MaliarPro.Card">
        <item name="cardBackgroundColor">@color/hero_card_background</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Semantic card aliases document intent at call sites while sharing one visual base. -->
    <style name="Widget.MaliarPro.FinancialCard" parent="Widget.MaliarPro.Card" />
    <style name="Widget.MaliarPro.AccountCard" parent="Widget.MaliarPro.Card" />
    <style name="Widget.MaliarPro.TransactionCard" parent="Widget.MaliarPro.Card" />
    <style name="Widget.MaliarPro.ReminderCard" parent="Widget.MaliarPro.Card" />
    <style name="Widget.MaliarPro.InstallmentCard" parent="Widget.MaliarPro.Card" />
    <style name="Widget.MaliarPro.DebtCard" parent="Widget.MaliarPro.Card" />
    <style name="Widget.MaliarPro.GoalCard" parent="Widget.MaliarPro.Card" />
    <style name="Widget.MaliarPro.InsightCard" parent="Widget.MaliarPro.Card" />
    <style name="Widget.MaliarPro.ReportCard" parent="Widget.MaliarPro.Card" />

    <style name="Widget.MaliarPro.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.MaliarPro.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/ds_outline</item>
    </style>

    <style name="Widget.MaliarPro.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.MaliarPro.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/primary</item>
        <item name="tint">@android:color/white</item>
    </style>

    <style name="TextAppearance.MaliarPro.SectionHeader" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.MaliarPro.Amount" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.MaliarPro.FilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/ds_surface_variant</item>
        <item name="chipStrokeColor">@color/ds_outline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
    </style>
</resources>
