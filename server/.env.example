# این‌ها را در Liara به‌عنوان متغیر محیطی (Environment Variable) تنظیم کنید،
# نه این‌که این فایل را مستقیم آپلود کنید.

# از پنل زرین‌پال (zarinpal.com) پس از ثبت‌نام مرچنت خودتان می‌گیرید:
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000

# روی true بگذارید تا اول با سرویس آزمایشی (sandbox) زرین‌پال تست کنید،
# بعد از اطمینان، false کنید تا پرداخت واقعی انجام شود.
ZARINPAL_SANDBOX=true

# آدرس عمومی همین بک‌اند بعد از دیپلوی (مثلاً چیزی شبیه
# https://maliar-billing.liara.run) - برای ساخت callback_url لازم است.
PUBLIC_BASE_URL=https://CHANGE-ME.liara.run

# قیمت‌ها به ریال (نه تومان!). 1 تومان = 10 ریال.
# ماهانه ۱۹۹,۰۰۰ تومان = ۱,۹۹۰,۰۰۰ ریال / سالانه ۱,۸۹۰,۰۰۰ تومان = ۱۸,۹۰۰,۰۰۰ ریال
PRICE_MONTHLY_RIAL=1990000
PRICE_YEARLY_RIAL=18900000

PORT=3000

# --- Bazaar / Myket in-app purchase verification (اختیاری) ---
# فقط لازم است اگر می‌خواهید کسانی که از کافه‌بازار یا مایکت نصب کرده‌اند از طریق
# پرداخت درون‌برنامه‌ای (نه مرورگر) اشتراک بخرند. اگر خالی بمانند، سرور فقط پرداخت
# مستقیم زرین‌پال را پشتیبانی می‌کند و آن دو کاربر باز هم می‌توانند از همان مسیر
# مرورگری استفاده کنند - چیزی خراب نمی‌شود.

# نام پکیج اپلیکیشن شما (همان applicationId در app/build.gradle.kts)
APP_PACKAGE_NAME=com.maliar.pro

# از پیشخان بازار می‌گیرید: برنامه شما -> API پیشخان بازار -> دریافت توکن جدید
# (روش جدید و ساده‌تر API بازار - هیچ OAuth2 یا refresh token لازم نیست).
BAZAAR_API_TOKEN=

# از پنل توسعه‌دهندگان مایکت می‌گیرید: برنامه شما -> بخش محصولات درون-برنامه‌ای -> X-Access-Token
# (بر خلاف بازار، هیچ OAuth2 یا refresh token لازم نیست - همین یک توکن ثابت کافیست).
MYKET_ACCESS_TOKEN=
